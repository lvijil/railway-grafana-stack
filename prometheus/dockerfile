ARG VERSION=v3.2.1

FROM prom/prometheus:${VERSION}

# Copy the prom.yml configuration file to the container
COPY prom.yml /etc/prometheus/prom.yml
COPY entrypoint.sh /etc/prometheus/entrypoint.sh

# Build the runtime config from Railway variables before starting Prometheus.
ENTRYPOINT ["/bin/sh", "/etc/prometheus/entrypoint.sh"]
